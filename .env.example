# Chain (never hardcode in source)
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Postgres (Render managed in production)
DATABASE_URL=postgres://user:pass@localhost:5432/stonkz_api

# Indexer tuning
CONFIRMATION_BUFFER=5
POLL_INTERVAL_MS=2000
LOG_LEVEL=info

# Robinhood RPC uses a leaf cert chain some Node builds reject locally.
# Set only for dev/backfill on Windows if eth_* calls fail TLS verification.
# NODE_TLS_REJECT_UNAUTHORIZED=0
