# Chain (never hardcode in source)
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Postgres (Render managed in production)
DATABASE_URL=postgres://user:pass@localhost:5432/stonkz_api

# Indexer tuning
CONFIRMATION_BUFFER=5
POLL_INTERVAL_MS=2000
LOG_LEVEL=info

# Read API (Step B)
PORT=3080
HOST=0.0.0.0
# Comma-separated browser origins allowed by CORS. Add staging/preview hosts here.
CORS_ORIGINS=https://stonkz.green,https://www.stonkz.green,https://stonkz.meme,http://localhost:3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
CACHE_TTL_SPOT_MS=3000
CACHE_TTL_CANDLES_MS=5000
CACHE_TTL_LISTINGS_MS=3000
CACHE_TTL_LISTING_FACTS_MS=60000
CACHE_TTL_HEALTH_MS=2000
CANDLES_MAX_ROWS=500
SSE_POLL_MS=2000
SSE_HEARTBEAT_MS=15000

# Robinhood RPC uses a leaf cert chain some Node builds reject locally.
# Set only for dev/backfill on Windows if eth_* calls fail TLS verification.
# NODE_TLS_REJECT_UNAUTHORIZED=0
